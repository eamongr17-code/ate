<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Only standard HTTPS/ATS crypto — exempt. Declared here so TestFlight builds
	     don't stall on the manual export-compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- The three voices (docs/DESIGN.md), all OFL, bundled from App/Resources/Fonts.
	     A synchronized Xcode group copies them to the bundle root, which is where these
	     paths point. AteType.swift also registers them at runtime as a safety net, so
	     SwiftUI previews and the debug gallery get the real faces too. -->
	<key>UIAppFonts</key>
	<array>
		<string>BricolageGrotesque-Variable.ttf</string>
		<string>Newsreader-Variable.ttf</string>
		<string>Newsreader-Italic-Variable.ttf</string>
		<string>DMMono-Regular.ttf</string>
		<string>DMMono-Medium.ttf</string>
		<string>DMMono-Italic.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- Asked only when the place sheet is first opened, never at launch, and only to list the
	     places near you. Design rule 8 stands: nothing is ever attached from a location. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ate lists the places near you when you're choosing where an entry happened. Nothing is attached until you tap one.</string>

	<!-- The composer's camera key. -->
	<key>NSCameraUsageDescription</key>
	<string>Ate uses the camera to take a photo of what you're eating, for the entry you're writing.</string>

	<!-- Asked only when Suggestions is opened, to offer recent photos to write up. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ate looks at your recent photos so it can offer the meals you haven't written up yet.</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Runtime configuration — filled from Config/{Debug,Release}.xcconfig at build time.
	     Read via AteKit's AteEnvironment; never hardcode these at a call site. -->
	<key>ATE_ENVIRONMENT</key>
	<string>$(ATE_ENVIRONMENT)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_KEY</key>
	<string>$(SUPABASE_KEY)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>TELEMETRYDECK_APP_ID</key>
	<string>$(TELEMETRYDECK_APP_ID)</string>
</dict>
</plist>
