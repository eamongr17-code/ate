<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's group: its keychain holds the signed-in session, its defaults the notes to the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eamongracias.ate</string>
	</array>
</dict>
</plist>
