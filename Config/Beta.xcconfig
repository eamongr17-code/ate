// Beta — Release-grade build pointed at STAGING. Used by TestFlight internal
// builds during build-out (environment law: test drives never touch prod).
// Promote to prod by shipping Release, not by editing this file.
#include? "Secrets.xcconfig"

ATE_ENVIRONMENT = beta
SUPABASE_URL = $(SUPABASE_URL_STAGING)
SUPABASE_KEY = $(SUPABASE_KEY_STAGING)

// BETA compiles the staging demo sign-in into TestFlight-internal builds (there is no real
// auth flow yet; without it a TestFlight install can only ever show signed-out states).
// Release never defines this, so the affordance cannot reach the App Store build.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) BETA
