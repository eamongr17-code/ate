// Copy to Secrets.xcconfig (gitignored) and fill in the placeholders.
// NOTE the $() in URLs: xcconfig treats "//" as a comment, so https:/$()/ is the standard escape.

// Sentry — the DSN is a public client key (committed here on purpose).
SENTRY_DSN = https:/$()/78fa30fe56b68c469131a3de7065f2cf@o4512005277483008.ingest.us.sentry.io/4512005282070528

// TelemetryDeck — public app identifier.
TELEMETRYDECK_APP_ID = REPLACE_ME

// Supabase — Debug points at STAGING, Release at prod. Anon keys are publishable, not secret,
// but live in the gitignored copy so staging/prod wiring stays explicit per machine.
SUPABASE_URL_STAGING = https:/$()/REPLACE_ME.supabase.co
SUPABASE_ANON_KEY_STAGING = REPLACE_ME
SUPABASE_URL_PROD = https:/$()/vyaexmnajnbryimbkgkf.supabase.co
SUPABASE_ANON_KEY_PROD = REPLACE_ME
