<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The commit a build came from, for the component gallery's stamp. Passed on the xcodebuild
	     command line (CI's Beta archive does); empty in a plain local build. -->
	<key>AteCommit</key>
	<string>$(ATE_COMMIT)</string>
	<key>AteCommitDate</key>
	<string>$(ATE_COMMIT_DATE)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Links into the app: a shared entry is ate://entry/<id> (AteKit's AteLinks). App-only until
	     a domain is picked; then AteLinks.base moves to https and universal links join this. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ate</string>
			</array>
		</dict>
	</array>
	<!-- Only standard HTTPS/ATS crypto — exempt. Declared here so TestFlight builds
	     don't stall on the manual export-compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
		<key>UIImageName</key>
		<string>LaunchWordmark</string>
	</dict>
	<!-- The four voices (docs/DESIGN.md), all OFL, bundled from App/Resources/Fonts.
	     A synchronized Xcode group copies them to the bundle root, which is where these
	     paths point. AteType.swift also registers them at runtime as a safety net, so
	     SwiftUI previews and the debug gallery get the real faces too. -->
	<key>UIAppFonts</key>
	<array>
		<string>YoungSerif-Regular.ttf</string>
		<string>BricolageGrotesque-Variable.ttf</string>
		<string>Newsreader-Variable.ttf</string>
		<string>Newsreader-Italic-Variable.ttf</string>
		<string>DMMono-Regular.ttf</string>
		<string>DMMono-Medium.ttf</string>
		<string>DMMono-Italic.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- Asked the first time something needs it — the Feed opening on Near me, Search's Nearby, the
	     place sheet — never at launch. Design rule 8 stands: nothing is ever attached from a
	     location, and resolve_city never stores the point. Round 5 copy, approved by Eamon. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ate shows what people are eating in your city, and lists places near you when you choose where an entry happened. Nothing is attached until you tap one.</string>

	<!-- The composer's camera key. -->
	<key>NSCameraUsageDescription</key>
	<string>Ate uses the camera to take a photo of what you're eating, for the entry you're writing.</string>

	<!-- Asked only when Suggestions is opened, to offer recent photos to write up. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ate looks at your recent photos so it can offer the meals you haven't written up yet.</string>

	<!-- Share: Save image writes the story page to Photos, add-only. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ate saves the picture you're sharing to your Photos.</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Runtime configuration — filled from Config/{Debug,Release}.xcconfig at build time.
	     Read via AteKit's AteEnvironment; never hardcode these at a call site. -->
	<key>ATE_ENVIRONMENT</key>
	<string>$(ATE_ENVIRONMENT)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_KEY</key>
	<string>$(SUPABASE_KEY)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>TELEMETRYDECK_APP_ID</key>
	<string>$(TELEMETRYDECK_APP_ID)</string>

	<!-- Share → Instagram Stories. The Facebook App ID Meta requires as source_application; empty
	     (and the option hidden) until one exists. One xcconfig key: ATE_FACEBOOK_APP_ID. -->
	<key>ATE_FACEBOOK_APP_ID</key>
	<string>$(ATE_FACEBOOK_APP_ID)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
</dict>
</plist>
